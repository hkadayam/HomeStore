native_include "sisl/fds/non_null_ptr.h";

namespace homestorecfg;

attribute "hotswap";
attribute "deprecated";

table BlkAllocator {
    // Number of attempts we try to allocate from cache before giving up
    max_slab_alloc_attempt: uint32 = 2 (hotswap);

    // Total number of segments the blkallocator is divided upto. Typical use of segment is to divide the
    // space into multiple access temperature of the blks, Having more helps better allocation - however,
    // too much without proper analysis cause lots of fragmentation.
    max_segments: uint32 = 1;

    // The entire blk space is divided into multiple portions. Having large number of portions provide lots of 
    // lock sharding, but increases the memory usage.
    num_blks_per_portion: uint32 = 16384;

    // Count of free blks cache in-terms of device size
    free_blk_cache_count_by_vdev_percent: double = 80.0;

    // Slab distribution percentage
    // An example assuming blk_size=4K and its slab distribution below
    // [4K,   8K,  16K, 32K, 64K,  128K, 256K, 512K, 1M  ]
    // [15.0, 7.0, 7.0, 6.0, 10.0, 10.0, 10.0, 10.0, 25.0]
    slab_distribution : [double];

    // Threshold percentage failling below which we start refilling the cache on that slab
    slab_refill_threshold_pct: double = 60;

    // Frequency at which slab cache refill is scheduled proactively so that a slab doesn't run out of space. This is
    // specified in ms. Default to 5 minutes. Having this value too low will cause more CPU usage in scanning
    // the bitmap, setting too high will cause run-out-of-slabs during allocation and thus cause increased write latency
    slab_refill_frequency_ms: uint64 =  300000;

    // Number of global variable block size allocator sweeping threads
    num_slab_sweeper_threads: uint32 = 2;
}

table Btree {
    // Max nodes to attempt to merge during a merge operation. Larger values reduce tree size on rarely-written trees
    // but cause more writes on frequently-changing trees. 3 is a reasonable balance.
    max_nodes_to_merge: uint32 = 3;

    // COW btree: starting/expansion chunk size for the node AppendBlkStream. At 4KB nodes, 128MB ~= 32K nodes/chunk.
    cow_node_chunk_size: uint64 = 134217728; // 128 MB

    // COW btree: starting/expansion chunk size for the overflow RawBlkStream. Overflow blobs are larger than nodes.
    // TODO: overflow stream creation should be caller-driven (skip when the btree variant never spills, e.g. fixed
    // nodes) instead of always allocated.
    cow_overflow_chunk_size: uint64 = 67108864; // 64 MB

    // COW btree: starting/expansion chunk size for the incremental map AppendByteStream.
    // 1MB ~= 26K records (avg 8 nodes/record) ~= 210K node updates per chunk.
    cow_incr_map_chunk_size: uint64 = 1048576; // 1 MB

    // COW btree: starting/expansion chunk size for the full map AppendByteStream (double-buffered).
    // 1MB ~= 174K entries x 6B/entry, mapping ~700MB of 4KB btree nodes per chunk.
    cow_full_map_chunk_size: uint64 = 1048576; // 1 MB

    // COW btree: incr_map flush threshold as percent of fast_dev_size. Once accumulated incr_map bytes across all
    // COW btrees exceed this fraction of fast_dev capacity, the next CP forces a full_map_flush which truncates the
    // incr_map streams. Tracked at COWBtreeManager level: append on flush, subtract on truncate.
    cow_incr_map_max_size_pct: double = 1 (hotswap);
}

table Cache {
    // Number of entries we ideally want to have per hash bucket. This number if small, will reduce contention and
    // speed of read/writes, but at the cost of increased memory
    entries_per_hash_bucket: uint32 = 2;

    // Number of eviction partitions. More the partitions better the parallelization of requests, but lesser the
    // effectiveness of cache, as it could get evicted sooner than expected, if distribution of key hashing is not even
    num_evictor_partitions: uint32 = 32;

    // 2Q ghost list capacity per partition. Ghost entries record keys that were recently evicted from the cold queue;
    // a hit in the ghost list promotes the next miss directly to the hot queue. Larger ghost lists improve hit-rate
    // on bursty workloads at the cost of memory.
    ghost_capacity_per_partition: uint32 = 4096;

    // 2Q hot-queue size as a percent of total cache size. The remaining (100 - hot_size_pct)% is the cold queue.
    // Lower this if your workload has weak temporal locality.
    hot_size_pct: double = 80 (hotswap);

    // Background evictor wakes when total cache size exceeds this percent of capacity. Must be > low_watermark_pct
    high_watermark_pct: double = 90 (hotswap);

    // Background evictor sleeps once total cache size falls below this percent of capacity.
    low_watermark_pct: double = 75 (hotswap);
}

table Device {
    // TODO: not yet implemented. Number of IO errors a PhysicalDev may incur before being marked down
    // and dependent vdevs degraded. Wiring up requires a per-pdev error counter, a down-state machine,
    // and propagation through DeviceManager.
    max_error_before_marking_dev_down: uint32 = 100 (hotswap);
}

table LogStore {
    // Auto-flush trigger #1 — accumulated unflushed bytes (excluding LogGroup framing overhead, ~20 B header
    // + 24 B/record). When pending bytes cross this threshold, the next quick_append schedules a flush.
    flush_threshold_size: uint64 = 4096 (hotswap); // 4KB

    // Auto-flush trigger #2 — wakeup interval for the time-based flush timer. Each tick: if there are pending
    // records and time since last flush exceeds max_time_between_flush_us, trigger flush.
    flush_timer_frequency_us: uint64 = 500 (hotswap);

    // Max latency between successive flushes when records are pending but flush_threshold_size hasn't been
    // reached. Bounds tail latency for low-throughput workloads.
    max_time_between_flush_us: uint64 = 300 (hotswap);

    // Sleep window in append_and_flush / write_and_flush before re-checking record status, to allow concurrent
    // appends to coalesce into the same LogGroup.
    flush_coalesce_wait_us: uint32 = 50 (hotswap);

    // Max number of LogGroups built per LogStream::flush() invocation before yielding the flush mutex.
    // Higher = more batching per flush, lower = fairer mutex hand-off under contention.
    max_flush_loops: uint32 = 4 (hotswap);

    // Number of blocks past a CRC break to scan for a still-valid LogGroup during recovery. If a valid group
    // is found within this window, the break is treated as a torn middle write (recovery aborts loudly)
    // rather than the legitimate tail. 0 = stop at first invalid group (legacy behavior).
    recovery_max_blks_read_for_additional_check: uint32 = 20;

    // Period between LogStoreManager auto-truncate sweeps: fans out LogStore::truncate(MAX) over opt-in stores,
    // then aggregates the cross-store min anchor and reclaims stream storage via LogStream::truncate.  Larger
    // intervals reduce metadata write amplification; smaller intervals reclaim storage sooner.
    auto_truncate_frequency_ms: uint64 = 300000 (hotswap); // 5 minutes
}

table ResourceLimits {
    // Absolute homestore process memory budget in bytes.  0 => derive proportionally from sys_mem_use_percent
    // (a fraction of total system RAM).
    process_mem_budget_bytes: uint64 = 0 (hotswap);

    // Percentage of total system memory to use as the process budget when process_mem_budget_bytes == 0.
    sys_mem_use_percent: uint32 = 60;

    // Percentage of the resolved process memory budget allocated to the homestore cache.
    cache_size_percent: uint32 = 65;

    // resource audit timer in ms
    resource_audit_timer_ms: uint32 = 120000;

    // Soft cap on the log-stream footprint (chunks it holds) as a percentage of FAST-device capacity.  The log
    // stream lives on the fast tier and its VDev auto-expands, so this bounds its growth relative to fast storage.
    // When footprint crosses this, ResourceMgr forces a truncation pass; the log stream itself also raises a
    // LogStreamSpaceExhausted event on the flush that crosses it, so reclaim can run without waiting for the poll.
    logstream_size_limit_pct: uint32 = 10 (hotswap);
}

table MetaBlkStore {
    // turn on/off compression feature
    compress_feature_on : bool = true (hotswap);

    // Try to do compress only when input buffer is larger than this size
    min_compress_size_mb: uint32 = 1 (hotswap);

    // Compress buffer larger than this memory limit in MB will not trigger compress;
    max_compress_size_mb: uint32 = 512 (hotswap);

    // Inital memory allocated for compress buffer
    init_compress_memory_size_mb: uint32 = 10 (hotswap);

    // Percentage of compress ratio that allowed for compress to take place
    compress_ratio_limit: uint32 = 75 (hotswap);
}

table Consensus {
    // ═══════════════════════════════════════════════════════════════════════════════════════════════════════════
    // nuraft raft_params — fed straight to the consensus engine when a ReplicaSet starts (see build_raft_params).
    // ═══════════════════════════════════════════════════════════════════════════════════════════════════════════

    // ── Leader election & heartbeat ─────────────────────────────────────────────────────────────────────────────

    // Leader->follower heartbeat / append interval (nuraft hb_interval). Must stay well below elect_to_low_ms.
    // Higher: less network/CPU overhead, but a dead leader is detected more slowly.
    // Lower:  followers stay fresher and elections are rarer, at a constant higher network cost.
    heartbeat_period_ms: uint32 = 250;

    // Randomized election-timeout window (nuraft election_timeout_lower/upper): a follower starts a new election if
    // it hears nothing from the leader within a random value in [low, high].  Both must exceed heartbeat_period_ms;
    // a wide (high-low) band avoids split votes.
    // Higher: slower failover on a dead leader, but fewer spurious elections on a slow/jittery network.
    // Lower:  faster failover, but more false-positive elections under transient delays.
    elect_to_low_ms: uint32 = 800;
    elect_to_high_ms: uint32 = 1700;

    // How long a leader retains leadership after it can no longer reach a quorum (nuraft leadership_expiry).
    // 0 = nuraft default (~20x heartbeat); -1 = never expire.
    // Higher: leader clings to leadership longer during a partition (risk of a stale leader).
    // Lower:  leader steps down quickly once it loses quorum -- faster failover, more leadership churn.
    leadership_expiry_ms: int32 = 0;

    // Delay before retrying an RPC to a peer after a failure (nuraft rpc_failure_backoff).
    // Higher: less retry traffic against a down/slow peer, but slower to resume once it recovers.
    // Lower:  faster recovery, but more retries hammering an unhealthy peer.
    rpc_backoff_ms: uint32 = 250;

    // ── Log replication & follower catch-up ─────────────────────────────────────────────────────────────────────

    // Max log entries packed into one append_entries RPC (nuraft max_append_size).
    // Higher: better throughput / fewer RPCs during catch-up, at larger per-RPC memory and latency spikes.
    // Lower:  smoother latency, but more RPC overhead.
    max_append_batch_size: int32 = 64;

    // Entries fetched per batch when a lagging follower bulk-syncs (nuraft log_sync_batch_size).
    // Higher: faster catch-up, but more memory and larger transfers.
    // Lower:  gentler on memory/network, but slower catch-up.
    log_sync_batch_size: int32 = 100;

    // Gap (entries) at which a catching-up member stops bulk log-sync and switches to normal replication -- i.e.
    // effectively "joins" (nuraft log_sync_stop_gap).  Default matches nuraft's default.
    // Higher: the member joins/votes sooner while still slightly behind (may briefly be a lagging voter).
    // Lower:  the member fully catches up before joining -- safer, but slower to become an active voter.
    min_log_gap_to_join: int32 = 99999;

    // Follower catch-up hysteresis (nuraft stale_log_gap / fresh_log_gap): a follower lagging the leader by more
    // than the hi threshold is "stale"; once it drops under the lo threshold it is "fresh" again.  hi > lo; widening
    // the band avoids flapping between the two states.
    stale_log_gap_hi_threshold: int32 = 200;
    stale_log_gap_lo_threshold: int32 = 30;

    // Log entries retained after a compaction so a lagging follower can catch up from the log instead of a full
    // snapshot (nuraft reserved_log_items).  GLOBAL default; a per-group ReplicaSetOptions.preserve_log_count wins
    // when set.
    // Higher: more followers catch up cheaply via the log, at the cost of more retained log storage.
    // Lower:  logs compact aggressively (less storage), but laggy followers more often need a full snapshot.
    num_reserved_log_items: uint32 = 20000;

    // ── Snapshots ───────────────────────────────────────────────────────────────────────────────────────────────

    // Committed-entry interval between automatic snapshots; 0 disables snapshotting (nuraft snapshot_distance).
    // GLOBAL default; a per-group ReplicaSetOptions.snapshot_distance can be used to override.
    // Higher: fewer snapshots (less snapshot IO/CPU), but longer retained logs and slower log-based catch-up.
    // Lower:  more frequent snapshots (more IO), but shorter logs and faster snapshot-based recovery.
    snapshot_freq_distance: uint32 = 2000;

    // Timeout for an in-progress snapshot install to a follower (nuraft snapshot_sync_ctx_timeout).  If the follower
    // doesn't respond within this window the leader releases the sync context.
    // Higher: tolerates slow followers / large snapshot transfers before aborting.
    // Lower:  aborts and retries a stuck snapshot transfer sooner.
    snapshot_sync_ctx_timeout_ms: int32 = 60000;

    // Run snapshot read/write IO on a background thread instead of the raft worker (nuraft use_bg_thread_for_snapshot_io).
    // true:  keeps the raft loop responsive during large snapshot IO.
    // false: simpler, but big snapshot IO can stall the raft thread.
    use_bg_thread_for_snapshot_io: bool = true;

    // ═══════════════════════════════════════════════════════════════════════════════════════════════════════════
    // HomeStore-internal -- consumed by the HomeStore replication layer, NOT passed to nuraft.
    // ═══════════════════════════════════════════════════════════════════════════════════════════════════════════

    // Frequency to flush the durable commit LSN to the SB, in millis.
    // Higher: less SB write amplification, but a crash loses a larger window of durable-commit progress (more replay).
    // Lower:  tighter durability watermark (less replay on restart), at more frequent SB writes.
    flush_durable_commit_interval_ms: uint64 = 500;

    // How often the reaper scans for DESTROYED replica sets to reclaim.
    // Higher: fewer idle scans (less CPU), but destroyed sets linger longer before reclamation.
    // Lower:  destroyed sets reclaimed sooner, at more frequent idle scans.
    replica_set_reaper_scan_interval_ms: uint64 = 30000;

    // Grace period a replica set stays DESTROYED before the reaper physically reclaims it (finish_destroy_local).
    // Higher: longer window for in-flight ops/references to a just-destroyed set to drain, at more lingering resources.
    // Lower:  faster resource reclamation, with less margin for stragglers still referencing the set.
    replica_set_reaper_grace_sec: uint32 = 60;

    // Log gap (leader's view) above which a follower is treated as laggy: the leader stops pushing data to it until
    // it drops back under this threshold.
    // Higher: leader keeps feeding a slow follower longer (more bandwidth to a laggard).
    // Lower:  leader cuts off a lagging follower sooner (protects healthy peers' throughput).
    laggy_threshold: int64 = 2000;

    // Log-index gap above which a follower is put into resync (bulk catch-up) mode instead of normal incremental
    // replication.
    // Higher: tolerate a larger gap before switching to bulk resync (more incremental replication).
    // Lower:  switch to bulk resync sooner when a follower falls behind.
    resync_log_idx_threshold: int64 = 100;

    // Base election priority for a member that a group bootstraps itself with, and the reference from which
    // new_member_priority is derived.  (Handed to nuraft via srv_config, not raft_params.)
    // Higher: this member is more strongly favored to win/hold leadership.
    // Lower:  less favored; equal across all members means a priority-neutral election.
    default_leader_priority: int32 = 100;

    // Multiplier applied to default_leader_priority to derive the priority of a member joining an existing group
    // after bootstrap.  Truncated to int32; a result that rounds to 0 is clamped to 1.
    // Higher (->1): new members join near full priority and may contend for leadership sooner.
    // Lower  (->0): new members join at much lower priority, strongly avoiding leadership until proven caught up.
    priority_decay_coefficient: double = 0.8;

    // Election-timeout rounds to wait during a prioritized election before a lower-priority peer may win.
    // NOTE: currently NOT consumed anywhere (no nuraft knob, no HomeStore reader) -- pending wiring or removal.
    // Higher: stronger priority enforcement (a lower-priority peer waits more rounds), slower election.
    // Lower:  weaker priority bias, faster election.  0 = all members equal.
    max_wait_rounds_of_priority_election: uint32 = 2;

    // How often replace_member checks whether the incoming member is fully synced and ready to take over.
    // Higher: less polling overhead, but slower to detect readiness (longer replace latency).
    // Lower:  detects readiness sooner (faster member replacement), at more frequent sync checks.
    replace_member_sync_check_interval_ms: uint64 = 60000;

    // Retries for a repl op that hits a "config changing" error while raft is mid-membership-change.
    // Higher: more tolerance for transient config-change contention (fewer surfaced errors), at longer stalls.
    // Lower:  fails config-dependent ops sooner during a config change.
    config_changing_error_retries: int32 = 3;

    // Time to wait for a config (membership) change to be applied, in ms.
    // Higher: waits longer for the change to commit before proceeding/erroring.
    // Lower:  gives up on a slow config change sooner.
    wait_for_config_change_ms: uint32 = 500;

    // Num entries the raft logstore reserves -- its truncate should not cross this floor.
    // Higher: more log retained so followers catch up via log rather than snapshot, at more log storage.
    // Lower / 0: HomeStore reserves nothing and lets nuraft control truncation.
    raft_logstore_reserve_threshold: uint32 = 0 (hotswap);
}

table Checkpoint {
    // Interval between checkpoint flushes, in microseconds (read by CPManager).
    // Higher: less frequent CPs -- lower write amplification, but more to replay after a crash.
    // Lower:  more frequent CPs -- tighter durability, at higher background flush cost.
    cp_timer_us: uint64 = 60000000 (hotswap);

    // Period (in seconds) at which the watchdog checks whether a CP is stuck (read by CPManager).
    // Higher: slower to detect a stuck CP; Lower: quicker detection, at more frequent checks.
    cp_watchdog_timer_sec: uint32 = 10;
}

// Fields no longer read by any code, parked here pending removal so the schema stays valid (and their defaults
// are preserved) without cluttering the live tables.  Do NOT add new references — delete this table once the
// removal is confirmed safe.
table Unused {
    index_max_dirty_memory_percent: double = 1 (hotswap);
    index_max_free_space_accumulate_percent: double = 1 (hotswap);
    free_blk_cnt: uint32 = 10000000 (hotswap);
    free_blk_size_percent: uint32 = 2 (hotswap);
    memory_in_recovery_precent: uint32 = 40;
    journal_vdev_size_percent: uint32 = 50;
    journal_vdev_size_percent_critical: uint32 = 90;
    journal_descriptor_size_threshold_mb: uint32 = 2048 (hotswap);
    vol_threshhold_used_size_p: uint32 = 95;

    // (moved out of the former Generic table -- unread by production code)
    btree_cp_flush_threads: uint32 = 2;
    btree_cp_flush_fibers_per_thread: uint32 = 8;
    cache_max_throttle_cnt: uint32 = 4;
    cache_min_throttle_cnt: uint32 = 4;
    cache_hashmap_nbuckets: uint32 = 1000000;
    cache_evictor_npartitions: uint32 = 1000;
    sanity_check_level: uint32 = 1 (hotswap);
    num_btree_write_threads: uint32 = 2;
    indx_mempool_percent: uint32 = 110;
    journal_chunk_pool_capacity: uint32 = 5;
}

table HomeStoreSettings {
    version: uint32 = 1;
    checkpoint: Checkpoint;
    blkallocator: BlkAllocator;
    cache: Cache;
    btree: Btree;
    device: Device;
    logstore: LogStore;
    resource_limits: ResourceLimits;
    metablk: MetaBlkStore;
    consensus: Consensus;
    unused: Unused;
}

root_type HomeStoreSettings;
